# Server Environment Configuration
PORT=5000
SERVER_URL=http://localhost:5000
NODE_ENV=development

# Client / Frontend URL
CLIENT_URL=https://task-nest-sage.vercel.app
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://task-nest-sage.vercel.app
APP_ORIGIN=https://task-nest-sage.vercel.app

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/tasknest

# JWT Authentication
JWT_SECRET=dev-access-secret-change-me
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Initial Admin Credentials (created on seed)
ADMIN_EMAIL=admin@tasknest.org
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Elena Rostova

# Email Configuration (Nodemailer / SMTP)
EMAIL_ENABLED=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=user@example.com
EMAIL_PASS=secret
EMAIL_FROM=TaskNest <no-reply@tasknest.org>

# Optional Resend API Key (if using Resend instead of SMTP)
RESEND_API_KEY=
